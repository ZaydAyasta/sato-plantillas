# Webhook de un canal PRIVADO de tu servidor de Discord.
# Discord > Ajustes del canal > Integraciones > Webhooks > Nuevo webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REEMPLAZA/ESTO

# Tu ID numérico de usuario de Discord para que cada solicitud te mencione.
# Activa Developer Mode en Discord > clic derecho en tu usuario > Copy User ID.
DISCORD_MENTION_USER_ID=123456789012345678

# Invitación pública de tu servidor para los botones "Hablar por Discord".
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/tu-invitacion

# Evita reenvíos repetidos desde la misma IP o username de Discord.
COMMISSION_COOLDOWN_MINUTES=10
